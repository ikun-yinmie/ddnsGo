# 控制台运行时状态
Nginx/control/control-state.json
Nginx/control/.runtime/
Nginx/control/__pycache__/
Nginx/control/.apply.lock

# 第三方工具整包(从官方获取)
Nginx/acme.sh/
Nginx/deb/

# Debian 包解包的二进制与文档
Nginx/root/usr/

*.pid
.DS_Store
