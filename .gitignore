# ddns-go 官方二进制(从 releases 下载)
ddns-go

# 便携 nginx 运行时产物
Nginx/logs/
Nginx/tmp/
Nginx/.runtime/
Nginx/conf.d/apps.conf
Nginx/conf.d/apps.conf.backup
